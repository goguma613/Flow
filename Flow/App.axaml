<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Flow.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Flow/Styles/Controls.axaml" />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/flow.ico"
                ToolTipText="Flow — 오늘의 할 일"
                Clicked="OnTrayClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <!-- 조합은 코드에서 붙인다. 여기 박아 두면 사용자가 바꾼 뒤에도 옛 조합이 남는다. -->
            <NativeMenuItem Header="열기" Click="OnTrayOpen" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="종료" Click="OnTrayExit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

</Application>
